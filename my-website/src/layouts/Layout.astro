---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mary',
  description = 'Quantitative Researcher at Flow Traders. Oxford Physics & Philosophy. Builder at the intersection of markets, models, and math.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@mmmhedge" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
