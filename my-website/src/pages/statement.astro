---
import Layout from '../layouts/Layout.astro';
---
<Layout title="PAVLENKO.M.A — Account Statement">
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap');
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: #09070c;
    color: #dfd8c8;
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 11px;
    line-height: 1.5;
    min-height: 100vh;
  }
  a { color: inherit; text-decoration: none; }

  .switcher {
    background: #0d0b10;
    border-bottom: 1px solid #1a1625;
    padding: 5px 20px;
    display: flex;
    gap: 14px;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .switcher span { color: #2d2840; font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; }
  .switcher a { font-size: 9px; letter-spacing: 0.08em; color: #3d3555; text-decoration: none; padding: 2px 8px; border: 1px solid transparent; transition: all 0.15s; }
  .switcher a:hover { color: #dfd8c8; border-color: #1a1625; }
  .switcher a.active { color: #c9a84c; border-color: rgba(201,168,76,0.35); }

  .page { max-width: 900px; margin: 0 auto; padding: 40px 40px 80px; }

  .firm-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 28px;
    padding-bottom: 18px;
    border-bottom: 2px solid #c9a84c;
  }
  .firm-name { font-size: 18px; font-weight: 700; color: #c9a84c; letter-spacing: 0.06em; }
  .firm-sub { font-size: 9px; color: #3d3555; letter-spacing: 0.14em; text-transform: uppercase; margin-top: 3px; }
  .doc-title { font-size: 12px; font-weight: 700; color: #dfd8c8; letter-spacing: 0.1em; text-transform: uppercase; text-align: right; }
  .doc-period { font-size: 9px; color: #3d3555; margin-top: 3px; letter-spacing: 0.06em; text-align: right; }

  .account-block {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1px;
    background: #1a1625;
    border: 1px solid #1a1625;
    margin-bottom: 28px;
  }
  .account-cell { background: #0d0b10; padding: 12px 14px; }
  .af-label { font-size: 8px; color: #2d2840; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 3px; }
  .af-value { font-size: 11px; color: #dfd8c8; letter-spacing: 0.03em; }
  .af-value.gold { color: #c9a84c; }

  .summary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 1px;
    background: #1a1625;
    border: 1px solid #1a1625;
    margin-bottom: 28px;
  }
  .summary-cell { background: #0d0b10; padding: 14px 16px; }
  .s-label { font-size: 8px; color: #2d2840; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 5px; }
  .s-value { font-size: 15px; font-weight: 700; color: #dfd8c8; }
  .s-value.gold { color: #c9a84c; }
  .s-value.green { color: #4a8c5c; }
  .s-value.sm { font-size: 11px; }

  .section-title {
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c9a84c;
    padding: 8px 0 6px;
    border-bottom: 1px solid #c9a84c;
    margin-bottom: 0;
  }

  table { width: 100%; border-collapse: collapse; margin-bottom: 28px; }
  th { font-size: 8px; letter-spacing: 0.12em; text-transform: uppercase; color: #2d2840; padding: 6px 8px; border-bottom: 1px solid #1a1625; text-align: left; font-weight: 400; }
  th.r { text-align: right; }
  td { padding: 9px 8px; border-bottom: 1px solid rgba(26,22,37,0.6); vertical-align: top; }
  tr:hover td { background: rgba(201,168,76,0.03); }

  .sym { font-weight: 700; color: #dfd8c8; letter-spacing: 0.05em; font-size: 11px; }
  .desc { font-size: 9px; color: #3d3555; margin-top: 2px; letter-spacing: 0.02em; }
  .dc { color: #2d2840; font-size: 10px; white-space: nowrap; }
  .rc { color: #4a4260; text-align: right; font-size: 10px; }
  .pc { text-align: right; font-size: 10px; white-space: nowrap; }
  .pos { color: #4a8c5c; }
  .sc { text-align: right; }

  .badge { font-size: 8px; letter-spacing: 0.08em; text-transform: uppercase; padding: 1px 6px; border: 1px solid; display: inline-block; }
  .b-closed { color: #2d2840; border-color: #1a1625; }
  .b-open { color: #4a8c5c; border-color: rgba(74,140,92,0.35); }
  .b-winner { color: #c9a84c; border-color: rgba(201,168,76,0.35); }
  .b-finalist { color: #6a52a0; border-color: rgba(106,82,160,0.35); }
  .b-top10 { color: #3a7a94; border-color: rgba(58,122,148,0.35); }

  .footer { border-top: 1px solid #1a1625; padding-top: 16px; display: flex; justify-content: space-between; align-items: center; margin-top: 8px; }
  .footer-note { font-size: 8px; color: #1a1625; letter-spacing: 0.06em; line-height: 1.8; }
  .footer-links { display: flex; gap: 16px; }
  .footer-links a { font-size: 9px; color: #2d2840; letter-spacing: 0.08em; transition: color 0.15s; }
  .footer-links a:hover { color: #c9a84c; }
</style>

<div class="switcher">
  <span>Concept</span>
  <a href="/">← Current</a>
  <a href="/order-book">Order Book</a>
  <a href="/statement" class="active">Statement</a>
  <a href="/fix">FIX Protocol</a>
  <a href="/arxiv">arXiv</a>
</div>

<div class="page">
  <div class="firm-header">
    <div>
      <div class="firm-name">MP CAPITAL</div>
      <div class="firm-sub">Human Capital Management · London, GBR</div>
    </div>
    <div>
      <div class="doc-title">Account Statement</div>
      <div class="doc-period">Period: 2019 — Present &nbsp;·&nbsp; Statement Date: June 2026</div>
    </div>
  </div>

  <div class="account-block">
    <div class="account-cell"><div class="af-label">Account Holder</div><div class="af-value gold">PAVLENKO, MARIIA A.</div></div>
    <div class="account-cell"><div class="af-label">Account Type</div><div class="af-value">HUMAN CAPITAL · ACTIVE</div></div>
    <div class="account-cell"><div class="af-label">Base Currency</div><div class="af-value">GBP · Mixed Asset</div></div>
    <div class="account-cell"><div class="af-label">Account No.</div><div class="af-value">MP-001-2026</div></div>
    <div class="account-cell"><div class="af-label">Risk Profile</div><div class="af-value">HIGH · Venture Stage</div></div>
    <div class="account-cell"><div class="af-label">Benchmark</div><div class="af-value">Standard Career +3σ</div></div>
  </div>

  <div class="summary-grid">
    <div class="summary-cell"><div class="s-label">Total Positions</div><div class="s-value gold">6</div></div>
    <div class="summary-cell"><div class="s-label">Projects Shipped</div><div class="s-value gold">10+</div></div>
    <div class="summary-cell"><div class="s-label">Realized P&L</div><div class="s-value green sm">A*A*A*A* · ETHBrussels · Top 10</div></div>
    <div class="summary-cell"><div class="s-label">Current Status</div><div class="s-value sm">SEEKING NEXT POSITION</div></div>
  </div>

  <div class="section-title">Closed Positions — Experience</div>
  <table>
    <thead>
      <tr>
        <th>Symbol / Description</th>
        <th>Open</th>
        <th>Close</th>
        <th class="r">Duration</th>
        <th class="r">Realized P&L</th>
        <th class="r">Status</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><div class="sym">OXFORD.PHYS.PHIL</div><div class="desc">MSc Physics & Philosophy · University of Oxford</div></td>
        <td class="dc">Sep 2019</td><td class="dc">Jun 2023</td>
        <td class="rc">4Y</td>
        <td class="pc pos">A*A*A*A*</td>
        <td class="sc"><span class="badge b-closed">CLOSED</span></td>
      </tr>
      <tr>
        <td><div class="sym">FLOW_TRADERS.QUANT</div><div class="desc">Quantitative Researcher · ML pricing engine, energy markets · Python/Kafka/ClickHouse</div></td>
        <td class="dc">Sep 2024</td><td class="dc">Sep 2025</td>
        <td class="rc">1Y</td>
        <td class="pc pos">+7.2% acc · −80% DT</td>
        <td class="sc"><span class="badge b-closed">CLOSED</span></td>
      </tr>
      <tr>
        <td><div class="sym">EF.FOUNDER_IN_RES</div><div class="desc">Entrepreneur First · ZK proofs + ML + open banking · iOS app shipped</div></td>
        <td class="dc">Jan 2023</td><td class="dc">Jul 2023</td>
        <td class="rc">6M</td>
        <td class="pc pos">100 users · shipped</td>
        <td class="sc"><span class="badge b-closed">CLOSED</span></td>
      </tr>
      <tr>
        <td><div class="sym">MAVEN_SECURITIES.INTERN</div><div class="desc">Trading Intern · Euro Stoxx options market-making · auction monitoring tool</div></td>
        <td class="dc">Jun 2022</td><td class="dc">Sep 2022</td>
        <td class="rc">3M</td>
        <td class="pc pos">Return offer ↗</td>
        <td class="sc"><span class="badge b-closed">CLOSED</span></td>
      </tr>
      <tr>
        <td><div class="sym">IMC_TRADING.FEMALE_PROG</div><div class="desc">Female Trading Program · delta-neutral hedging algorithms in Python</div></td>
        <td class="dc">Jul 2021</td><td class="dc">Aug 2021</td>
        <td class="rc">6W</td>
        <td class="pc pos">Top 10 internal comp</td>
        <td class="sc"><span class="badge b-closed">CLOSED</span></td>
      </tr>
      <tr>
        <td><div class="sym">FAIR.CO_FOUNDER</div><div class="desc">ESG fintech brokerage co-founder · 50+ person team · UCL EFS competition winner</div></td>
        <td class="dc">Oct 2021</td><td class="dc">Sep 2022</td>
        <td class="rc">11M</td>
        <td class="pc pos">UCL EFS winner</td>
        <td class="sc"><span class="badge b-closed">CLOSED</span></td>
      </tr>
    </tbody>
  </table>

  <div class="section-title">Open & Settled Positions — Projects</div>
  <table>
    <thead>
      <tr>
        <th>Instrument</th>
        <th>Type</th>
        <th>Opened</th>
        <th class="r">Underlying</th>
        <th class="r">Settlement</th>
        <th class="r">Status</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><div class="sym">LLMTRANSITION.RESEARCH</div><div class="desc">Phase transitions in LLM hallucination dynamics · solid-state physics analogies</div></td>
        <td class="dc">LONG</td><td class="dc">2024</td>
        <td class="rc">Physics → ML</td>
        <td class="pc" style="color:#3d3555">Ongoing</td>
        <td class="sc"><span class="badge b-open">OPEN</span></td>
      </tr>
      <tr>
        <td><div class="sym">BLOCKROCK.DEFI</div><div class="desc">On-chain fund management with dynamic rebalancing · Solidity</div></td>
        <td class="dc">CALL</td><td class="dc">2024-06</td>
        <td class="rc">ETHBrussels 2024</td>
        <td class="pc pos">1st Place</td>
        <td class="sc"><span class="badge b-winner">WINNER</span></td>
      </tr>
      <tr>
        <td><div class="sym">HEDGY.AMM</div><div class="desc">Automated market-making · delta-neutral hedging on Optiver Optibook</div></td>
        <td class="dc">STRADDLE</td><td class="dc">2024-03</td>
        <td class="rc">Optiver Optibook</td>
        <td class="pc pos">Top 10</td>
        <td class="sc"><span class="badge b-top10">TOP 10</span></td>
      </tr>
      <tr>
        <td><div class="sym">VOUCH_FINANCE.DEFI</div><div class="desc">Undercollateralized DeFi lending via social staking & on-chain credit reputation</div></td>
        <td class="dc">CALL</td><td class="dc">2024-01</td>
        <td class="rc">Solidity · ZK</td>
        <td class="pc" style="color:#6a52a0">Finalist</td>
        <td class="sc"><span class="badge b-finalist">FINALIST</span></td>
      </tr>
      <tr>
        <td><div class="sym">EX2.COMPUTE</div><div class="desc">Decentralized compute marketplace · AI Hack London 2024</div></td>
        <td class="dc">CALL</td><td class="dc">2023-09</td>
        <td class="rc">AI Hack LDN</td>
        <td class="pc" style="color:#6a52a0">Finalist</td>
        <td class="sc"><span class="badge b-finalist">FINALIST</span></td>
      </tr>
    </tbody>
  </table>

  <div class="footer">
    <div class="footer-note">
      This statement is generated for informational purposes only.<br>
      Past performance does not guarantee future results. All positions subject to market conditions.
    </div>
    <div class="footer-links">
      <a href="mailto:mariia.a.pavlenko@gmail.com">Email</a>
      <a href="https://github.com/ppo6" target="_blank">GitHub</a>
      <a href="https://x.com/mmmhedge" target="_blank">@mmmhedge</a>
      <a href="/cv.pdf" target="_blank">CV ↓</a>
    </div>
  </div>
</div>
</Layout>
