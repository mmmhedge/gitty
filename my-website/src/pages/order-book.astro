          </div>
        </div>

        <div class="row" style="--d:46%" id="a4">
          <div class="row-left">
            <div class="row-name">Research collaboration</div>
            <div class="row-det">LLMs · microstructure · stat mech</div>
          </div>
          <div class="row-right">
            <div class="metric m">DAY</div>
          </div>
        </div>

        <div class="row" style="--d:30%" id="a5">
          <div class="row-left">
            <div class="row-name">Seed / pre-seed capital</div>
            <div class="row-det">Thesis-driven. Interesting problem required.</div>
          </div>
          <div class="row-right">
            <div class="metric m">GTC</div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- BLOTTER ────────────────────────────────────── -->
  <div class="blotter">
    <div class="bl-head"><div class="pulse"></div>TRADE BLOTTER — RECENT FILLS</div>
    <div class="bl-rows">
      <div class="bl-row">
        <span class="bl-t">2024-09</span><span class="bl-b">BUY</span>
        <span class="bl-name">FLOW_TRADERS.QUANT — ML pricing, energy markets</span>
        <span class="bl-p">+7.2% acc · −80% DT</span>
        <span class="tag filled">FILLED</span>
      </div>
      <div class="bl-row">
        <span class="bl-t">2024-06</span><span class="bl-b">BUY</span>
        <span class="bl-name">BLOCKROCK — on-chain fund management · ETHBrussels</span>
        <span class="bl-p">First place</span>
        <span class="tag winner">WINNER</span>
      </div>
      <div class="bl-row">
        <span class="bl-t">2024-03</span><span class="bl-b">BUY</span>
        <span class="bl-name">HEDGY — delta-neutral AMM · Optiver Optibook</span>
        <span class="bl-p">Optiver comp</span>
        <span class="tag top">TOP 10</span>
      </div>
