        <span class="tag fin">FINALIST</span>
      </div>
      <div class="bl-row">
        <span class="bl-t">2024→</span><span class="bl-b">BUY</span>
        <span class="bl-name">LLMPHASETRANSITION — physics → LLM hallucination</span>
        <span class="bl-p">ongoing</span>
        <span class="tag open">OPEN</span>
