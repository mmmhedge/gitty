            <div class="row-name">Zero→One Building</div>
            <div class="row-det">iOS shipped · 100 users · 50-person team</div>
          </div>
          <div class="row-right">
            <div class="metric g">2 cos</div>
            <div class="cond">EF · fair co-founder</div>
          </div>
        </div>

        <div class="row" style="--d:50%" id="b5">
          <div class="row-left">
            <div class="row-name">AI Research</div>
            <div class="row-det">LLM hallucination · phase transition theory</div>
          </div>
          <div class="row-right">
            <div class="metric a">active</div>
            <div class="cond">LLMPhaseTransition</div>
          </div>
        </div>

        <div class="row" style="--d:36%" id="b6">
          <div class="row-left">
            <div class="row-name">Hackathon Alpha</div>
            <div class="row-det">DeFi · AI · distributed compute · 3 prizes</div>
          </div>
          <div class="row-right">
            <div class="metric g">10+</div>
            <div class="cond">events shipped</div>
          </div>
        </div>

      </div>
    </div>

    <!-- ASK ──────────────────────────────────────── -->
    <div class="side ask">
      <div class="col-head">
        <span class="col-title r">ASK — What I Want</span>
        <span class="col-sub">Seeking</span>
      </div>
      <div class="rows">

        <div class="row" style="--d:96%" id="a0">
          <div class="row-left">
            <div class="row-name">Hard AI + Markets problems</div>
            <div class="row-det">Unsolved. Real constraints. Mission-driven.</div>
          </div>
          <div class="row-right">
            <div class="metric r">IOC</div>
          </div>
        </div>

        <div class="row" style="--d:82%" id="a1">
          <div class="row-left">
            <div class="row-name">Technical co-founder</div>
            <div class="row-det">Complementary skills. High conviction.</div>
          </div>
          <div class="row-right">
            <div class="metric r">GTC</div>
          </div>
        </div>

        <div class="row" style="--d:74%" id="a2">
          <div class="row-left">
            <div class="row-name">Crypto × Quant intersection</div>
            <div class="row-det">DeFi market structure. On-chain data.</div>
          </div>
          <div class="row-right">
            <div class="metric r">GTC</div>
          </div>
        </div>

        <div class="row" style="--d:60%" id="a3">
          <div class="row-left">
            <div class="row-name">First-principles thinkers</div>
            <div class="row-det">Physics / math background preferred.</div>
          </div>
          <div class="row-right">
