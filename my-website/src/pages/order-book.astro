</div>

<div class="foot">
  <a href="mailto:mariia.a.pavlenko@gmail.com">mariia.a.pavlenko@gmail.com</a>
  <span class="sep">|</span>
  <a href="https://github.com/ppo6" target="_blank">github.com/ppo6</a>
  <span class="sep">|</span>
  <a href="https://x.com/mmmhedge" target="_blank">@mmmhedge</a>
  <span class="sep">|</span>
  <a href="/cv.pdf" target="_blank">CV ↓</a>
</div>

<script is:inline>
  // Clock
  const clk = document.getElementById('clk');
  function tick() { clk.textContent = new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit'}); }
  tick(); setInterval(tick, 1000);

  // Live depth-bar animation — slightly shift each row's depth
  const bidRows  = ['b0','b1','b2','b3','b4','b5','b6'];
  const askRows  = ['a0','a1','a2','a3','a4','a5'];
  const baseBid  = [94, 88, 80, 71, 62, 50, 36];
  const baseAsk  = [96, 82, 74, 60, 46, 30];

  function nudge(ids, bases) {
    const i = Math.floor(Math.random() * ids.length);
    const el = document.getElementById(ids[i]);
    if (!el) return;
    const delta = (Math.random() - 0.5) * 8;
    const next  = Math.max(8, Math.min(98, bases[i] + delta));
    el.style.setProperty('--d', next + '%');
  }

  setInterval(() => { nudge(bidRows, baseBid); nudge(askRows, baseAsk); }, 420);
  setInterval(() => { nudge(bidRows, baseBid); }, 700);

  // Random flash on a bid row — simulates a "hit"
  setInterval(() => {
    const id = bidRows[Math.floor(Math.random() * bidRows.length)];
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.add('flash-g');
    setTimeout(() => el.classList.remove('flash-g'), 180);
  }, 2800);

  // Random flash on an ask row
  setInterval(() => {
    const id = askRows[Math.floor(Math.random() * askRows.length)];
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.add('flash-r');
    setTimeout(() => el.classList.remove('flash-r'), 180);
  }, 4100);

  // Cycle best-bid text
  const bids = ['ML+Quant','Physics','DeFi/Blockchain','Market Making','AI Research'];
  let bi = 0;
  const bb = document.getElementById('bb');
  setInterval(() => { bi = (bi+1)%bids.length; bb.textContent = bids[bi]; }, 3500);
</script>
</Layout>
