---
import Layout from '../layouts/Layout.astro';
---
<Layout title="PAVLENKO.M.A — Order Book">
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap');
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; overflow: hidden; }
  body {
    background: #050810;
    color: #e2e8f0;
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 12px;
    display: flex;
    flex-direction: column;
    height: 100vh;
  }

  /* ── switcher ─────────────────────────────────── */
  .sw {
    background: #0d1117;
    border-bottom: 1px solid #1e293b;
    padding: 4px 16px;
    display: flex;
    gap: 12px;
    align-items: center;
    flex-shrink: 0;
  }
  .sw span { color: #1e293b; font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; }
  .sw a { font-size: 9px; color: #334155; text-decoration: none; padding: 2px 7px; border: 1px solid transparent; transition: all 0.15s; }
  .sw a:hover { color: #cbd5e1; border-color: #1e293b; }
  .sw a.on { color: #22d3ee; border-color: rgba(34,211,238,0.3); }

  /* ── ticker ───────────────────────────────────── */
  .ticker {
    background: #080d16;
    border-bottom: 1px solid #1e293b;
    padding: 0 16px;
    height: 44px;
    display: flex;
    align-items: center;
    gap: 0;
    overflow: hidden;
    flex-shrink: 0;
  }
  .t-instr { font-size: 15px; font-weight: 700; color: #f1f5f9; letter-spacing: 0.08em; padding-right: 20px; border-right: 1px solid #1e293b; margin-right: 20px; white-space: nowrap; }
  .t-stat { display: flex; flex-direction: column; justify-content: center; padding: 0 18px; border-right: 1px solid #1e293b; height: 100%; }
  .t-stat:last-child { border: none; }
  .t-lbl { font-size: 8px; color: #334155; letter-spacing: 0.14em; text-transform: uppercase; }
  .t-val { font-size: 12px; color: #e2e8f0; margin-top: 1px; }
  .t-val.g { color: #22c55e; }
  .t-val.r { color: #ef4444; }
  .t-val.a { color: #22d3ee; }

  /* ── book ─────────────────────────────────────── */
  .main { display: flex; flex-direction: column; flex: 1; overflow: hidden; }
  .book { display: grid; grid-template-columns: 1fr 1fr; flex: 1; overflow: hidden; }
  .side { display: flex; flex-direction: column; overflow: hidden; }
  .side.bid { border-right: 1px solid #1e293b; }

  .col-head {
    padding: 6px 16px;
    border-bottom: 1px solid #1e293b;
    background: #080d16;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
  }
  .col-title { font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; }
  .col-title.g { color: #22c55e; }
  .col-title.r { color: #ef4444; }
  .col-sub { font-size: 8px; color: #1e293b; letter-spacing: 0.1em; text-transform: uppercase; }

  .rows { flex: 1; overflow-y: auto; scrollbar-width: none; }
  .rows::-webkit-scrollbar { display: none; }

  /* bid row */
  .row {
    padding: 10px 16px;
    border-bottom: 1px solid rgba(30,41,59,0.35);
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    cursor: default;
    transition: background 0.25s ease;
  }
  .bid .row {
    background: linear-gradient(to left, rgba(34,197,94,0.08) var(--d,70%), transparent var(--d,70%));
  }
  .ask .row {
    background: linear-gradient(to right, rgba(239,68,68,0.08) var(--d,70%), transparent var(--d,70%));
  }
  .row.flash-g { background: rgba(34,197,94,0.18) !important; }
  .row.flash-r { background: rgba(239,68,68,0.18) !important; }

  .row-left { flex: 1; min-width: 0; }
  .row-name { font-size: 12px; color: #e2e8f0; font-weight: 700; letter-spacing: 0.03em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .row-det { font-size: 9px; color: #334155; letter-spacing: 0.04em; margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .row-right { flex-shrink: 0; text-align: right; padding-left: 12px; }
  .metric { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; }
  .metric.g { color: #22c55e; }
  .metric.r { color: #ef4444; }
  .metric.a { color: #22d3ee; }
  .metric.m { color: #94a3b8; }
  .cond { font-size: 8px; color: #1e293b; letter-spacing: 0.12em; margin-top: 3px; }

  /* ── blotter ──────────────────────────────────── */
  .blotter { border-top: 2px solid #1e293b; height: 180px; display: flex; flex-direction: column; flex-shrink: 0; }
  .bl-head {
    padding: 5px 16px;
    background: #080d16;
    border-bottom: 1px solid #1e293b;
    font-size: 8px;
    color: #334155;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    display: flex;
    gap: 8px;
    align-items: center;
    flex-shrink: 0;
  }
  .pulse { width: 5px; height: 5px; border-radius: 50%; background: #22c55e; animation: blink 1.4s ease-in-out infinite; }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.15} }

  .bl-rows { overflow-y: auto; scrollbar-width: none; flex: 1; }
  .bl-rows::-webkit-scrollbar { display: none; }

  .bl-row {
    display: grid;
    grid-template-columns: 72px 46px 1fr 100px 72px;
    gap: 10px;
    padding: 5px 16px;
    border-bottom: 1px solid rgba(30,41,59,0.25);
    align-items: center;
    font-size: 10px;
  }
  .bl-row:hover { background: rgba(255,255,255,0.015); }
  .bl-t { color: #1e293b; }
  .bl-b { color: #22c55e; font-weight: 700; }
  .bl-name { color: #cbd5e1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bl-p { color: #475569; text-align: right; white-space: nowrap; }
  .tag { font-size: 8px; letter-spacing: 0.07em; padding: 1px 5px; border: 1px solid; text-align: right; display: inline-block; white-space: nowrap; }
  .tag.filled  { color: #22c55e; border-color: rgba(34,197,94,0.3); }
  .tag.winner  { color: #f59e0b; border-color: rgba(245,158,11,0.3); }
  .tag.fin     { color: #8b5cf6; border-color: rgba(139,92,246,0.3); }
  .tag.top     { color: #22d3ee; border-color: rgba(34,211,238,0.3); }
  .tag.open    { color: #475569; border-color: #1e293b; }

  /* ── footer ───────────────────────────────────── */
  .foot {
    background: #080d16;
    border-top: 1px solid #1e293b;
    padding: 5px 16px;
    display: flex;
    gap: 18px;
    align-items: center;
    flex-shrink: 0;
  }
  .foot a { font-size: 9px; color: #334155; text-decoration: none; letter-spacing: 0.08em; transition: color 0.15s; }
  .foot a:hover { color: #22d3ee; }
  .foot .sep { color: #1e293b; }
</style>

<div class="sw">
  <span>Concept</span>
  <a href="/">← Original</a>
  <a href="/order-book" class="on">Order Book</a>
  <a href="/fix">FIX Protocol</a>
</div>

<div class="ticker">
  <div class="t-instr">PAVLENKO.M.A</div>
  <div class="t-stat"><div class="t-lbl">Status</div><div class="t-val g">● OPEN</div></div>
  <div class="t-stat"><div class="t-lbl">Desk</div><div class="t-val">LON / GBR</div></div>
  <div class="t-stat"><div class="t-lbl">Best Bid</div><div class="t-val g" id="bb">ML+Quant</div></div>
  <div class="t-stat"><div class="t-lbl">Best Ask</div><div class="t-val r">Hard Problems</div></div>
  <div class="t-stat"><div class="t-lbl">Wins</div><div class="t-val a">3 prizes · 10+ fills</div></div>
  <div class="t-stat"><div class="t-lbl">Time (GMT)</div><div class="t-val" id="clk">--:--:--</div></div>
</div>

<div class="main">
  <div class="book">

    <!-- BID ──────────────────────────────────────── -->
    <div class="side bid">
      <div class="col-head">
        <span class="col-title g">BID — What I Bring</span>
        <span class="col-sub">Skill / Credential</span>
