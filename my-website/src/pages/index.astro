<script is:inline>
  // Nav scroll
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 40);
  }, { passive: true });

  // Market chart — drawn into the right-column canvas
  // No background fill: lines float on the dark page background
  (function () {
    const canvas = document.getElementById('market-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const N = 6000;
    const PX = 2.5;

    function randn() {
      return (Math.random() + Math.random() + Math.random() + Math.random() - 2) / 1.2;
    }

    function genPath(drift, vol, start) {
      const p = new Float32Array(N);
      p[0] = start;
      for (let i = 1; i < N; i++) {
        p[i] = Math.max(0.05, Math.min(0.95, p[i - 1] + drift + vol * randn()));
      }
      return p;
    }

    // Different starting positions so lines spread across the column height
    const series = [
      { p: genPath( 0.00010, 0.006, 0.30), color: 'rgba(34,211,238,0.7)',   lw: 1.5 },
      { p: genPath(-0.00008, 0.008, 0.55), color: 'rgba(34,211,238,0.3)',   lw: 1   },
      { p: genPath( 0.00005, 0.005, 0.72), color: 'rgba(148,163,184,0.25)', lw: 1   },
      { p: genPath(-0.00012, 0.007, 0.18), color: 'rgba(34,211,238,0.15)',  lw: 0.8 },
    ];

    let offset = 0;
    let rafId  = null;

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      canvas.width  = canvas.offsetWidth  * dpr;
      canvas.height = canvas.offsetHeight * dpr;
      ctx.scale(dpr, dpr);
    }

    function draw() {
      const w = canvas.offsetWidth;
      const h = canvas.offsetHeight;
      ctx.clearRect(0, 0, w, h);

      // Subtle grid — feels like a chart without overpowering
      ctx.strokeStyle = 'rgba(30,41,59,0.4)';
      ctx.lineWidth   = 0.5;
      for (let i = 1; i < 10; i++) {
        ctx.beginPath();
        ctx.moveTo(0, i * h / 10);
        ctx.lineTo(w, i * h / 10);
        ctx.stroke();
      }
      for (let i = 1; i < 6; i++) {
        ctx.beginPath();
        ctx.moveTo(i * w / 6, 0);
        ctx.lineTo(i * w / 6, h);
        ctx.stroke();
      }

      // Price lines
      const startIdx = Math.floor(offset / PX);
      const xOff     = offset % PX;
      const count    = Math.ceil(w / PX) + 2;

      series.forEach(({ p, color, lw }, si) => {
        ctx.strokeStyle = color;
        ctx.lineWidth   = lw;
        ctx.lineJoin    = 'round';
        ctx.beginPath();
        let moved = false;
        for (let i = 0; i < count; i++) {
          const x = i * PX - xOff;
          const y = p[(startIdx + i) % N] * h;
          if (!moved) { ctx.moveTo(x, y); moved = true; }
          else          ctx.lineTo(x, y);
        }
        ctx.stroke();

        // Live dot on primary line
        if (si === 0) {
          const lx = (count - 2) * PX - xOff;
          const ly = p[(startIdx + count - 2) % N] * h;
          ctx.beginPath(); ctx.arc(lx, ly, 3, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(34,211,238,1)'; ctx.fill();
          ctx.beginPath(); ctx.arc(lx, ly, 7, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(34,211,238,0.12)'; ctx.fill();
        }
      });

      offset = (offset + 0.4) % (N * PX);
      rafId  = requestAnimationFrame(draw);
    }

    const obs = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { if (!rafId) { resize(); draw(); } }
      else { cancelAnimationFrame(rafId); rafId = null; }
    });
    obs.observe(canvas);

    window.addEventListener('resize', () => {
      cancelAnimationFrame(rafId); rafId = null; resize(); draw();
    }, { passive: true });

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      resize(); draw();
    }
  })();
</script>
