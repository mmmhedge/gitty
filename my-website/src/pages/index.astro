---
import Layout from '../layouts/Layout.astro';
---
<!--
  Liquid-metal monogram concept.
  Shader + WebGL pipeline adapted from paper-design/liquid-logo (github.com/paper-design/liquid-logo),
  licensed under the PolyForm Shield License 1.0.0 <https://polyformproject.org/licenses/shield/1.0.0>.
  Required Notice: portions © paper-design (https://liquid.paper.design).
-->
<Layout title="Mary">
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap');
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; overflow: hidden; }
  body {
    background: radial-gradient(ellipse at 50% 15%, #100e18 0%, #08070c 55%, #050507 100%);
    color: #d8d6e0;
    font-family: 'Space Mono', 'Courier New', monospace;
    font-size: 12px;
    display: flex; flex-direction: column; height: 100vh;
  }

  .main { flex: 1; overflow-y: auto; display: flex; flex-direction: column; align-items: center; padding: clamp(24px,4vw,48px) 20px 48px; gap: 14px; }

  .logo-stage {
    width: min(380px, 70vw); height: min(380px, 70vw);
    position: relative;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: -90px;
  }
  .logo-stage canvas { width: 100%; height: 100%; display: block; }
  .logo-loading { position: absolute; font-size: 9px; color: #45434f; letter-spacing: 0.12em; text-transform: uppercase; }

  .tagline { text-align: center; max-width: 520px; }
  .tagline .surname { font-size: 11px; color: #9d97b8; letter-spacing: 0.3em; margin: 0; }
  .tagline p { font-size: 12px; color: #6b6878; line-height: 1.7; margin-top: 14px; }

  .creds { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; max-width: 560px; }
  .cred { font-size: 9.5px; color: #9d97b8; border: 1px solid #1c1c22; padding: 4px 10px; border-radius: 20px; letter-spacing: 0.03em; background: #0b0b0e; }

  .explore { width: 100%; max-width: 640px; margin-top: 12px; display: flex; flex-direction: column; align-items: center; }
  .explore-toggle { display: flex; gap: 10px; margin-bottom: 22px; }
  .explore-btn {
    font-family: 'Space Mono', monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase;
    color: #6b6878; background: #0b0b0e; border: 1px solid #1c1c22; border-radius: 20px;
    padding: 7px 18px; cursor: pointer; transition: all 0.2s;
  }
  .explore-btn:hover { color: #d8d6e0; border-color: rgba(201,196,224,0.25); }
  .explore-btn.active { color: #c9c4e0; border-color: rgba(201,196,224,0.5); background: rgba(201,196,224,0.06); }

  .projects-grid { display: none; width: 100%; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .projects-grid.shown { display: grid; }
  @media (max-width: 560px) { .projects-grid { grid-template-columns: repeat(2, 1fr); } }
  .proj-card {
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    padding: 16px 8px; border: 1px solid #1c1c22; border-radius: 10px; background: #0b0b0e;
    text-decoration: none;
    opacity: 0; transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s ease, border-color 0.2s, box-shadow 0.2s;
  }
  .proj-card.in { opacity: 1; transform: translateY(0); }
  .proj-card.in:hover { border-color: rgba(201,196,224,0.35); transform: translateY(-2px); }
  .proj-card.placeholder { border-style: dashed; cursor: default; }
  .proj-card.placeholder.in { opacity: 0.45; }
  .proj-card.placeholder.in:hover { border-color: #1c1c22; transform: translateY(0); }
  .proj-icon canvas { width: 36px; height: 36px; display: block; }
  .proj-name { font-size: 10px; color: #d8d6e0; letter-spacing: 0.02em; text-align: center; }
  .proj-tag { font-size: 8px; color: #45434f; letter-spacing: 0.05em; text-align: center; }
</style>

<div class="main">
  <div class="logo-stage">
    <span class="logo-loading" id="loadingLabel">compiling shader…</span>
    <canvas id="liquidCanvas"></canvas>
  </div>

  <div class="tagline">
    <div class="surname">PAVLENKO</div>
    <p>Oxford Physics & Philosophy '23. Ex-quant (commodities & crypto). 3x founder. Winner of 10+ international hackathons.</p>
  </div>

  <div class="creds">
    <span class="cred">applied mech interp</span>
    <span class="cred">A2A infra</span>
    <span class="cred">web3//defi</span>
    <span class="cred">fintech</span>
    <span class="cred">quant trading</span>
  </div>

  <div class="explore">
    <div class="explore-toggle">
      <button class="explore-btn" id="btnProjects" type="button">Projects</button>
      <button class="explore-btn" id="btnWriting" type="button">Writing</button>
      <button class="explore-btn" id="btnContact" type="button">Contact</button>
    </div>
    <div class="projects-grid" id="projectsGrid"></div>
    <div class="projects-grid" id="writingGrid"></div>
    <div class="projects-grid" id="contactGrid"></div>
  </div>
</div>

<script>
import { PROJECTS, WRITING, CONTACT, ICONS } from '../lib/explore-data.ts';

(function () {
  // Vertex + fragment shader ported from paper-design/liquid-logo (src/hero/canvas.tsx, src/app/hero/liquid-frag.ts)
  const vertexShaderSource = `#version 300 es
precision mediump float;
in vec2 a_position;
out vec2 vUv;
void main() {
  vUv = .5 * (a_position + 1.);
  gl_Position = vec4(a_position, 0.0, 1.0);
}`;

  const fragmentShaderSource = `#version 300 es
precision mediump float;
in vec2 vUv;
out vec4 fragColor;
uniform sampler2D u_image_texture;
uniform float u_time;
uniform float u_ratio;
uniform float u_img_ratio;
uniform float u_patternScale;
uniform float u_refraction;
uniform float u_edge;
uniform float u_patternBlur;
uniform float u_liquid;
#define TWO_PI 6.28318530718
#define PI 3.14159265358979323846
vec3 mod289(vec3 x) { return x - floor(x * (1. / 289.)) * 289.; }
vec2 mod289(vec2 x) { return x - floor(x * (1. / 289.)) * 289.; }
vec3 permute(vec3 x) { return mod289(((x*34.)+1.)*x); }
float snoise(vec2 v) {
    const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
    vec2 i = floor(v + dot(v, C.yy));
    vec2 x0 = v - i + dot(i, C.xx);
    vec2 i1;
    i1 = (x0.x > x0.y) ? vec2(1., 0.) : vec2(0., 1.);
    vec4 x12 = x0.xyxy + C.xxzz;
    x12.xy -= i1;
    i = mod289(i);
    vec3 p = permute(permute(i.y + vec3(0., i1.y, 1.)) + i.x + vec3(0., i1.x, 1.));
    vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.);
    m = m*m; m = m*m;
    vec3 x = 2. * fract(p * C.www) - 1.;
    vec3 h = abs(x) - 0.5;
    vec3 ox = floor(x + 0.5);
    vec3 a0 = x - ox;
    m *= 1.79284291400159 - 0.85373472095314 * (a0*a0 + h*h);
    vec3 g;
    g.x = a0.x * x0.x + h.x * x0.y;
    g.yz = a0.yz * x12.xz + h.yz * x12.yw;
    return 130. * dot(m, g);
}
vec2 get_img_uv() {
    vec2 img_uv = vUv;
    img_uv -= .5;
    if (u_ratio > u_img_ratio) { img_uv.x = img_uv.x * u_ratio / u_img_ratio; }
    else { img_uv.y = img_uv.y * u_img_ratio / u_ratio; }
    img_uv += .5;
    img_uv.y = 1. - img_uv.y;
    return img_uv;
}
vec2 rotate(vec2 uv, float th) { return mat2(cos(th), sin(th), -sin(th), cos(th)) * uv; }
float get_color_channel(float c1, float c2, float stripe_p, vec3 w, float extra_blur, float b) {
    float ch = c2;
    float border = 0.;
    float blur = u_patternBlur + extra_blur;
    ch = mix(ch, c1, smoothstep(.0, blur, stripe_p));
    border = w[0];
    ch = mix(ch, c2, smoothstep(border - blur, border + blur, stripe_p));
    b = smoothstep(.2, .8, b);
    border = w[0] + .4 * (1. - b) * w[1];
    ch = mix(ch, c1, smoothstep(border - blur, border + blur, stripe_p));
    border = w[0] + .5 * (1. - b) * w[1];
    ch = mix(ch, c2, smoothstep(border - blur, border + blur, stripe_p));
    border = w[0] + w[1];
    ch = mix(ch, c1, smoothstep(border - blur, border + blur, stripe_p));
    float gradient_t = (stripe_p - w[0] - w[1]) / w[2];
    float gradient = mix(c1, c2, smoothstep(0., 1., gradient_t));
    ch = mix(ch, gradient, smoothstep(border - blur, border + blur, stripe_p));
    return ch;
}
float get_img_frame_alpha(vec2 uv, float img_frame_width) {
    float img_frame_alpha = smoothstep(0., img_frame_width, uv.x) * smoothstep(1., 1. - img_frame_width, uv.x);
    img_frame_alpha *= smoothstep(0., img_frame_width, uv.y) * smoothstep(1., 1. - img_frame_width, uv.y);
    return img_frame_alpha;
}
void main() {
    vec2 uv = vUv;
    uv.y = 1. - uv.y;
    uv.x *= u_ratio;
    float diagonal = uv.x - uv.y;
    float t = .001 * u_time;
    vec2 img_uv = get_img_uv();
    vec4 img = texture(u_image_texture, img_uv);
    vec3 color = vec3(0.);
    float opacity = 1.;
    vec3 color1 = vec3(.98, 0.98, 1.);
    vec3 color2 = vec3(.1, .1, .1 + .1 * smoothstep(.7, 1.3, uv.x + uv.y));
    float edge = img.r;
    vec2 grad_uv = uv;
    grad_uv -= .5;
    float dist = length(grad_uv + vec2(0., .2 * diagonal));
    grad_uv = rotate(grad_uv, (.25 - .2 * diagonal) * PI);
    float bulge = pow(1.8 * dist, 1.2);
    bulge = 1. - bulge;
    bulge *= pow(uv.y, .3);
    float cycle_width = u_patternScale;
    float thin_strip_1_ratio = .12 / cycle_width * (1. - .4 * bulge);
    float thin_strip_2_ratio = .07 / cycle_width * (1. + .4 * bulge);
    float wide_strip_ratio = (1. - thin_strip_1_ratio - thin_strip_2_ratio);
    float thin_strip_1_width = cycle_width * thin_strip_1_ratio;
    float thin_strip_2_width = cycle_width * thin_strip_2_ratio;
    opacity = 1. - smoothstep(.9 - .5 * u_edge, 1. - .5 * u_edge, edge);
    opacity *= get_img_frame_alpha(img_uv, 0.01);
    float noise = snoise(uv - t);
    edge += (1. - edge) * u_liquid * noise;
    float refr = 0.;
    refr += (1. - bulge);
    refr = clamp(refr, 0., 1.);
    float dir = grad_uv.x;
    dir += diagonal;
    dir -= 2. * noise * diagonal * (smoothstep(0., 1., edge) * smoothstep(1., 0., edge));
    bulge *= clamp(pow(uv.y, .1), .3, 1.);
    dir *= (.1 + (1.1 - edge) * bulge);
    dir *= smoothstep(1., .7, edge);
    dir += .18 * (smoothstep(.1, .2, uv.y) * smoothstep(.4, .2, uv.y));
    dir += .03 * (smoothstep(.1, .2, 1. - uv.y) * smoothstep(.4, .2, 1. - uv.y));
    dir *= (.5 + .5 * pow(uv.y, 2.));
    dir *= cycle_width;
    dir -= t;
    float refr_r = refr;
    refr_r += .03 * bulge * noise;
    float refr_b = 1.3 * refr;
    refr_r += 5. * (smoothstep(-.1, .2, uv.y) * smoothstep(.5, .1, uv.y)) * (smoothstep(.4, .6, bulge) * smoothstep(1., .4, bulge));
    refr_r -= diagonal;
    refr_b += (smoothstep(0., .4, uv.y) * smoothstep(.8, .1, uv.y)) * (smoothstep(.4, .6, bulge) * smoothstep(.8, .4, bulge));
    refr_b -= .2 * edge;
    refr_r *= u_refraction;
    refr_b *= u_refraction;
    vec3 w = vec3(thin_strip_1_width, thin_strip_2_width, wide_strip_ratio);
    w[1] -= .02 * smoothstep(.0, 1., edge + bulge);
    float stripe_r = mod(dir + refr_r, 1.);
    float r = get_color_channel(color1.r, color2.r, stripe_r, w, 0.02 + .03 * u_refraction * bulge, bulge);
    float stripe_g = mod(dir, 1.);
    float g = get_color_channel(color1.g, color2.g, stripe_g, w, 0.01 / (1. - diagonal), bulge);
    float stripe_b = mod(dir - refr_b, 1.);
    float b = get_color_channel(color1.b, color2.b, stripe_b, w, .01, bulge);
    color = vec3(r, g, b);
    color *= opacity;
    fragColor = vec4(color, opacity);
}`;

  // Build a soft distance-style mask from the "MARY" wordmark, same idea as
  // paper-design/liquid-logo's parseLogoImage(): white at the silhouette edge,
  // dark toward the interior, solved with a small Poisson relaxation.
  function buildMonogramMask(size) {
    const shapeCanvas = document.createElement('canvas');
    shapeCanvas.width = size; shapeCanvas.height = size;
    const sctx = shapeCanvas.getContext('2d');
    sctx.fillStyle = '#fff';
    sctx.fillRect(0, 0, size, size);
    sctx.fillStyle = '#000';
    sctx.textAlign = 'center';
    sctx.textBaseline = 'middle';
    const WORDMARK = 'MARY';
    const targetWidth = size * 0.84;
    const probeSize = Math.round(size * 0.3);
    sctx.font = `700 ${probeSize}px "Helvetica Neue", Arial, sans-serif`;
    const measuredWidth = sctx.measureText(WORDMARK).width;
    const fitSize = Math.round(probeSize * (targetWidth / measuredWidth));
    sctx.font = `700 ${fitSize}px "Helvetica Neue", Arial, sans-serif`;
    sctx.fillText(WORDMARK, size / 2, size / 2 + size * 0.02);

    const { data } = sctx.getImageData(0, 0, size, size);
    const shapeMask = new Uint8Array(size * size);
    for (let p = 0; p < size * size; p++) {
      const r = data[p * 4];
      shapeMask[p] = r < 128 ? 1 : 0;
    }

    function inside(x, y) {
      if (x < 0 || x >= size || y < 0 || y >= size) return false;
      return shapeMask[y * size + x] === 1;
    }

    const boundaryMask = new Uint8Array(size * size);
    for (let y = 0; y < size; y++) {
      for (let x = 0; x < size; x++) {
        const idx = y * size + x;
        if (!shapeMask[idx]) continue;
        let isBoundary = false;
        for (let ny = y - 1; ny <= y + 1 && !isBoundary; ny++) {
          for (let nx = x - 1; nx <= x + 1 && !isBoundary; nx++) {
            if (!inside(nx, ny)) isBoundary = true;
          }
        }
        if (isBoundary) boundaryMask[idx] = 1;
      }
    }

    let u = new Float32Array(size * size);
    let newU = new Float32Array(size * size);
    const C = 0.01;
    const ITERATIONS = 120;
    function getU(x, y, arr) {
      if (x < 0 || x >= size || y < 0 || y >= size) return 0;
      if (!shapeMask[y * size + x]) return 0;
      return arr[y * size + x];
    }
    for (let iter = 0; iter < ITERATIONS; iter++) {
      for (let y = 0; y < size; y++) {
        for (let x = 0; x < size; x++) {
          const idx = y * size + x;
          if (!shapeMask[idx] || boundaryMask[idx]) { newU[idx] = 0; continue; }
          const sumN = getU(x + 1, y, u) + getU(x - 1, y, u) + getU(x, y + 1, u) + getU(x, y - 1, u);
          newU[idx] = (C + sumN) / 4;
        }
      }
      const tmp = u; u = newU; newU = tmp;
    }

    let maxVal = 0;
    for (let i = 0; i < size * size; i++) if (u[i] > maxVal) maxVal = u[i];

    const out = new ImageData(size, size);
    const alpha = 2.0;
    for (let y = 0; y < size; y++) {
      for (let x = 0; x < size; x++) {
        const idx = y * size + x;
        const px = idx * 4;
        if (!shapeMask[idx]) {
          out.data[px] = 255; out.data[px + 1] = 255; out.data[px + 2] = 255; out.data[px + 3] = 255;
        } else {
          const raw = maxVal > 0 ? u[idx] / maxVal : 0;
          const remapped = Math.pow(raw, alpha);
          const gray = 255 * (1 - remapped);
          out.data[px] = gray; out.data[px + 1] = gray; out.data[px + 2] = gray; out.data[px + 3] = 255;
        }
      }
    }
    return out;
  }

  const params = {
    patternScale: 2,
    refraction: 0.015,
    edge: 0.4,
    patternBlur: 0.005,
    liquid: 0.07,
    speed: 0.3,
  };

  function setupLiquidShader() {
  const canvas = document.getElementById('liquidCanvas');
  const loadingLabel = document.getElementById('loadingLabel');
  const gl = canvas.getContext('webgl2', { antialias: true, alpha: true });
  if (!gl) { loadingLabel.textContent = 'WebGL2 unsupported in this browser'; return; }

  function createShader(source, type) {
    const shader = gl.createShader(type);
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      console.error(gl.getShaderInfoLog(shader));
      return null;
    }
    return shader;
  }

  const vs = createShader(vertexShaderSource, gl.VERTEX_SHADER);
  const fs = createShader(fragmentShaderSource, gl.FRAGMENT_SHADER);
  const program = gl.createProgram();
  gl.attachShader(program, vs);
  gl.attachShader(program, fs);
  gl.linkProgram(program);
  if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
    console.error(gl.getProgramInfoLog(program));
    loadingLabel.textContent = 'shader link failed';
    return;
  }
  gl.useProgram(program);

  const uniforms = {};
  const uniformCount = gl.getProgramParameter(program, gl.ACTIVE_UNIFORMS);
  for (let i = 0; i < uniformCount; i++) {
    const name = gl.getActiveUniform(program, i).name;
    uniforms[name] = gl.getUniformLocation(program, name);
  }

  const vertices = new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]);
  const vertexBuffer = gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER, vertexBuffer);
  gl.bufferData(gl.ARRAY_BUFFER, vertices, gl.STATIC_DRAW);
  const positionLocation = gl.getAttribLocation(program, 'a_position');
  gl.enableVertexAttribArray(positionLocation);
  gl.vertexAttribPointer(positionLocation, 2, gl.FLOAT, false, 0, 0);

  gl.uniform1f(uniforms.u_edge, params.edge);
  gl.uniform1f(uniforms.u_patternBlur, params.patternBlur);
  gl.uniform1f(uniforms.u_patternScale, params.patternScale);
  gl.uniform1f(uniforms.u_refraction, params.refraction);
  gl.uniform1f(uniforms.u_liquid, params.liquid);
  gl.uniform1f(uniforms.u_ratio, 1);
  gl.uniform1f(uniforms.u_img_ratio, 1);

  const maskSize = 300;
  const maskData = buildMonogramMask(maskSize);
  const texture = gl.createTexture();
  gl.activeTexture(gl.TEXTURE0);
  gl.bindTexture(gl.TEXTURE_2D, texture);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
  gl.pixelStorei(gl.UNPACK_ALIGNMENT, 1);
  gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, maskSize, maskSize, 0, gl.RGBA, gl.UNSIGNED_BYTE, maskData.data);
  gl.uniform1i(uniforms.u_image_texture, 0);

  loadingLabel.style.display = 'none';

  function resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const side = canvas.clientWidth;
    canvas.width = side * dpr;
    canvas.height = side * dpr;
    gl.viewport(0, 0, canvas.width, canvas.height);
  }
  resize();
  window.addEventListener('resize', resize);

  let totalTime = 0, lastTime = performance.now();
  let rafId = null;

  function render(now) {
    const dt = now - lastTime;
    lastTime = now;
    totalTime += dt * params.speed;
    gl.uniform1f(uniforms.u_time, totalTime);
    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    rafId = requestAnimationFrame(render);
  }

  const obs = new IntersectionObserver(([e]) => {
    if (e.isIntersecting) { if (!rafId) { lastTime = performance.now(); rafId = requestAnimationFrame(render); } }
    else if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
  });
  obs.observe(canvas);

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    rafId = requestAnimationFrame(render);
  }
  }
  setupLiquidShader();

  // PROJECTS, WRITING, CONTACT, and ICONS now live in ../lib/explore-data.ts
  // (imported above) so the data + icon set can be unit tested.

  function drawProjectIcon(canvas, iconName) {
    const dpr = window.devicePixelRatio || 1;
    const size = 36;
    canvas.width = size * dpr;
    canvas.height = size * dpr;
    const ctx = canvas.getContext('2d');
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    (ICONS[iconName] || ICONS.plus)(ctx);
  }

  function renderGrid(gridEl, items) {
    items.forEach((item, i) => {
      const el = document.createElement(item.placeholder ? 'div' : 'a');
      el.className = 'proj-card' + (item.placeholder ? ' placeholder' : '');
      el.style.transitionDelay = `${i * 55}ms`;
      if (!item.placeholder) {
        el.href = item.url;
        if (item.url.startsWith('http')) { el.target = '_blank'; el.rel = 'noopener'; }
        else if (item.url === '#') { el.addEventListener('click', (e) => e.preventDefault()); }
      }
      const icon = document.createElement('div');
      icon.className = 'proj-icon';
      const cnv = document.createElement('canvas');
      icon.appendChild(cnv);
      const name = document.createElement('div');
      name.className = 'proj-name';
      name.textContent = item.name;
      const tag = document.createElement('div');
      tag.className = 'proj-tag';
      tag.textContent = item.tag;
      el.append(icon, name, tag);
      gridEl.appendChild(el);
      drawProjectIcon(cnv, item.icon);
    });
  }

  const SECTIONS = {
    projects: { grid: document.getElementById('projectsGrid'), btn: document.getElementById('btnProjects'), items: PROJECTS },
    writing: { grid: document.getElementById('writingGrid'), btn: document.getElementById('btnWriting'), items: WRITING },
    contact: { grid: document.getElementById('contactGrid'), btn: document.getElementById('btnContact'), items: CONTACT },
  };

  for (const key in SECTIONS) renderGrid(SECTIONS[key].grid, SECTIONS[key].items);

  let activeKey = null;

  function showSection(which) {
    if (which === activeKey) return;

    if (activeKey) {
      const prev = SECTIONS[activeKey];
      prev.grid.querySelectorAll('.proj-card.in').forEach(c => c.classList.remove('in'));
      const prevGrid = prev.grid;
      setTimeout(() => { if (SECTIONS[activeKey]?.grid !== prevGrid) prevGrid.classList.remove('shown'); }, 350);
    }

    const target = SECTIONS[which];
    target.grid.classList.add('shown');
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        target.grid.querySelectorAll('.proj-card').forEach(c => c.classList.add('in'));
      });
    });

    activeKey = which;
    for (const key in SECTIONS) SECTIONS[key].btn.classList.toggle('active', key === which);
  }

  for (const key in SECTIONS) SECTIONS[key].btn.addEventListener('click', () => showSection(key));
})();
</script>
</Layout>
